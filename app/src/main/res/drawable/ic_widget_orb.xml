<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="40dp"
    android:height="40dp"
    android:viewportWidth="40"
    android:viewportHeight="40">

    <!-- Ambient mint aura glow -->
    <path
        android:pathData="M20,6 A14,14 0 1,1 19.9,6">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="20"
                android:centerY="20"
                android:gradientRadius="18"
                android:startColor="#4DC5E1A5"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>

    <!-- 3D Mesh Equator Ring -->
    <path
        android:strokeWidth="1.2"
        android:strokeColor="#C5E1A5"
        android:pathData="M8,20 C8,15 32,15 32,20 C32,25 8,25 8,20 Z" />

    <!-- 3D Upper Latitude Ring -->
    <path
        android:strokeWidth="1.0"
        android:strokeColor="#FFFFFF"
        android:pathData="M11,15 C11,11 29,11 29,15 C29,19 11,19 11,15 Z" />

    <!-- 3D Lower Latitude Ring -->
    <path
        android:strokeWidth="1.0"
        android:strokeColor="#4ADE80"
        android:pathData="M11,25 C11,21 29,21 29,25 C29,29 11,29 11,25 Z" />

    <!-- 3D Longitudinal Arcs -->
    <path
        android:strokeWidth="1.2"
        android:strokeColor="#86EFAC"
        android:pathData="M20,9 C15,9 15,31 20,31 C25,31 25,9 20,9 Z" />

    <!-- Central Focal Particles -->
    <path android:pathData="M20,19 A1.3,1.3 0 1,1 19.9,19" android:fillColor="#FFFFFF" />
    <path android:pathData="M16,16 A1,1 0 1,1 15.9,16" android:fillColor="#C5E1A5" />
    <path android:pathData="M24,16 A1,1 0 1,1 23.9,16" android:fillColor="#FFFFFF" />
    <path android:pathData="M15,22 A0.9,0.9 0 1,1 14.9,22" android:fillColor="#4ADE80" />
    <path android:pathData="M25,22 A0.9,0.9 0 1,1 24.9,22" android:fillColor="#86EFAC" />

</vector>
